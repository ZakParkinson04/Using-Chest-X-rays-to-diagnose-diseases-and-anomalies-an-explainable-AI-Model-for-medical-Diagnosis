        "def Create_Split(Raw_Dir, Split_Dir, Train_Ratio = 0.7, Val_Ratio = 0.15, seed = 42):\n",
        "  Raw_Dir = Path(Raw_Dir)\n",
        "  Split_Dir = Path(Split_Dir)\n",
        "\n",
        "  if (Split_Dir / \"train\").exists() and (Split_Dir / \"val\").exists() and (Split_Dir / \"test\").exists():\n",
        "    print(\"Data split already exists.\")\n",
        "    return\n",
        "\n",
        "  Image_Exts = {\".png\", \".jpg\", \".jpeg\"}\n",
        "  rng = random.Random(seed)\n",
        "\n",
        "  for Class_Dir in sorted([p for p in Raw_Dir.iterdir() if p.is_dir()]):\n",
        "    Images = [p for p in Class_Dir.rglob(\"*\") if p.suffix.lower() in Image_Exts]\n",
        "    rng.shuffle(Images)\n",
        "\n",
        "    Total = len(Images)\n",
        "    Train_Count = round(Total * Train_Ratio)\n",
        "    Val_Count = round(Total * Val_Ratio)\n",
        "\n",
        "    Train_Files = Images[:Train_Count]\n",
        "    Val_Files = Images[Train_Count:Train_Count + Val_Count]\n",
        "    Test_Files = Images[Train_Count + Val_Count:]\n",
        "\n",
        "    Split_Map = {\n",
        "        \"train\": Train_Files,\n",
        "        \"val\": Val_Files,\n",
        "        \"test\": Test_Files\n",
        "    }\n",
        "\n",
        "    for Split_Name, Files in Split_Map.items():\n",
        "      for src in Files:\n",
        "        Rel_Path = src.relative_to(Class_Dir)\n",
        "        Dest = Split_Dir / Split_Name / Class_Dir.name / Rel_Path\n",
        "        Dest.parent.mkdir(parents=True, exist_ok=True)\n",
        "        shutil.copy2(src, Dest)\n",
        "\n",
        "    print(\n",
        "        f\"{Class_Dir.name}: Total = {Total}, \"\n",
        "        f\"Train = {len(Train_Files)}, \"\n",
        "        f\"Val = {len(Val_Files)}, \"\n",
        "        f\"Test = {len(Test_Files)}\"\n",
        "    )\n",
        "\n",
        "Create_Split(Raw_Combined_Data_Direct, Data_Direct)\n",
